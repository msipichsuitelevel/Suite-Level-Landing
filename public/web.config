<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the exported site.

  This file sits in `public/`, so `next build` copies it verbatim to the root of
  `out/`. Deploy `out/` as the site's physical directory; there is no Node
  process to run.

  It deliberately uses only core IIS features - default documents, static
  content, custom errors and outbound headers. Nothing here needs the URL
  Rewrite module, which is a separate install and is often missing.
-->
<configuration>
  <system.webServer>

    <!--
      `trailingSlash: true` in next.config.mjs makes every route a directory
      with an index.html inside it, so IIS resolves /privacy-policy/ by its
      default document and needs no rewrite rules.
    -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!--
        IIS refuses to serve an extension it has no MIME mapping for, and
        returns 404 rather than an error that explains why. `remove` before each
        `add` keeps this idempotent: a duplicate mapping inherited from the
        parent configuration is a 500 at startup, not a warning.
      -->
      <!--
        No-cache is the default here so that HTML, which points at the hashed
        asset URLs, is always revalidated. The <location> blocks at the bottom
        opt the immutable assets back into long caching.
      -->
      <clientCache cacheControlMode="DisableCache" />

      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
    </staticContent>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <!--
        Next exports the not-found page as /404.html. `responseMode="File"`
        serves it while keeping the 404 status, which `ExecuteURL` would turn
        into a 200 and make the page indexable.
      -->
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), interest-cohort=()" />

        <!--
          Content-Security-Policy is left off by default because it has to name
          the API origin this site posts to, which differs per environment and
          is not knowable from this repository. Getting it wrong fails closed:
          the access-request form stops working with no visible error except in
          the browser console.

          To switch it on, replace API-ORIGIN below with the value of
          NEXT_PUBLIC_API_URL the site was built with, then uncomment.
          The google.com and gstatic.com entries are reCAPTCHA; 'unsafe-inline'
          in script-src covers Next's bootstrap and the JSON-LD blocks.

          <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' API-ORIGIN; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'" />
        -->
      </customHeaders>
    </httpProtocol>

    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

  </system.webServer>

  <!--
    Everything Next puts under /_next/static/ carries a content hash in its
    name, so a change means a new URL and these may be cached permanently.
    HTML must NOT be cached this way: it is what points at the hashed assets,
    and a stale copy pins visitors to an old build.
  -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="shots">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
