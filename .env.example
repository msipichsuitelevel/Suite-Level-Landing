# Copy to `.env.local` and fill in. `.env.local` is git-ignored and must stay
# that way: this repository is public.
#
# Everything here is NEXT_PUBLIC_*, which means it is inlined into the exported
# JavaScript and is readable by anyone who views the site. Only values that are
# public by design belong in this file. The reCAPTCHA SECRET key is NOT one of
# them: it lives in the API's app settings and never appears in this repo.

# Base URL of the Suite Level API that receives access requests.
# No trailing slash.
NEXT_PUBLIC_API_URL=https://api.example.com

# Canonical origin this site is served from. Used for canonical URLs, sitemap
# entries, Open Graph URLs and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# reCAPTCHA site key. Public by design; the matching secret key stays in the
# API's app settings.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Which reCAPTCHA product the site key above belongs to. A key is registered for
# exactly one of these and the wrong value fails with "Invalid site key".
#   v2-invisible  no widget; the challenge runs on submit (what Suite Level uses)
#   v2-checkbox   the visible "I'm not a robot" tick box
#   v3            scored in the background, never interactive
NEXT_PUBLIC_RECAPTCHA_VERSION=v2-invisible
